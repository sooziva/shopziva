{
  "name": "shopziva",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "db:migrate": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "auth:migrate": "npx auth@latest migrate --yes",
    "auth:seed": "ALLOW_ADMIN_SIGNUP=true tsx scripts/seed-admin.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@paystack/inline-js": "^2.28.2",
    "better-auth": "^1.7.28",
    "dotenv": "^18.0.10",
    "framer-motion": "^14.9.1",
    "hono": "^4.13.22",
    "lucide-react": "^1.69.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/paystack__inline-js": "^1.0.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
