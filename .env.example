# Local Postgres
DATABASE_URL=postgresql://ekaygabriel@localhost:5432/shopziva

# Paystack (Dashboard → Settings → API Keys & Webhooks)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: leave blank in local dev (Vite proxies /api → :8787)
# In production (Vercel), point at your API host if separate from the site
# VITE_API_URL=https://api.example.com
PORT=8787

# Better Auth — use the public site URL in production
# BETTER_AUTH_URL=https://shop.sooziva.com
# BETTER_AUTH_SECRET=generate-a-long-random-string
# WEB_ORIGIN=https://shop.sooziva.com
# ADMIN_EMAILS=admin@shopziva.com

# Required on Vercel for Hono + Node serverless
# NODEJS_HELPERS=0
# Use Neon pooled URL (…-pooler….neon.tech), not localhost

